# Copy this file to .env and fill in real values.
# NEVER commit .env to Git or put it in a zip you share.

PORT=5000
NODE_ENV=production

# MongoDB Atlas (use a dedicated DB user with only the permissions this app needs)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/paymentdb?retryWrites=true&w=majority

# Strong random strings (>= 32 chars). Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used ONLY to encrypt KYC documents (AES-256-GCM). REQUIRED in production.
# Keep it separate from JWT_SECRET. If you lose or change it, existing encrypted documents
# become unreadable -> back it up. (If your database already contains KYC docs, set
# LEGACY_ENCRYPTION_KEY to your OLD JWT_SECRET value before rotating JWT_SECRET.)
ENCRYPTION_KEY=
LEGACY_ENCRYPTION_KEY=

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-frontend-domain.com

# Educa Mail integration
MAIL_SERVER_URL=
MAIL_API_KEY=
MESSAGES_MONGO_URI=

# Optional
WEBHOOK_SECRET=
FCM_SERVER_KEY=
RENDER_EXTERNAL_URL=

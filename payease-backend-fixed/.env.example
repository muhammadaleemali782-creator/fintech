# Ye file copy karke .env banao aur apni real values daalo
# .env file KABHI Git/GitHub pe push mat karna

PORT=5000
NODE_ENV=production

# MongoDB Atlas (production ke liye local MongoDB use mat karna)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/paymentdb

# Ye ek strong random string honi chahiye — kam se kam 32 characters
# Generate karne ke liye: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Tumhari live frontend URL (jaise https://payease.vercel.app)
# Comma se separate karke multiple domains bhi de sakte ho
CLIENT_URL=https://your-frontend-domain.com
